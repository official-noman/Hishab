{
  "name": "Hishab — Money tracker",
  "short_name": "Hishab",
  "description": "Private, offline personal and family expense tracker with bank, bKash and cash imports, charts and reports.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#0B0F14",
  "theme_color": "#0B0F14",
  "lang": "en",
  "dir": "ltr",
  "categories": ["finance", "productivity"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Import statement", "short_name": "Import", "url": "./#/import", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "View report", "short_name": "Report", "url": "./#/report", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
